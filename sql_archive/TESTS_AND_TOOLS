
-- ADD OWNER CAPITAL OPENING BALANCE
-- Purpose: Inject a Capital entry to test the Equity Report
DO $$
DECLARE
    v_capital_account_id UUID;
    v_cash_account_id UUID;
    v_voucher_no TEXT;
    v_amount NUMERIC := 5000000; -- 50 Lakh Investment
    v_date DATE := '2026-01-01';
BEGIN
    -- 1. Get or Create Owner's Capital Account
    SELECT id INTO v_capital_account_id FROM accounts WHERE slug = 'owner-capital' OR name ILIKE '%Capital%';
    
    IF v_capital_account_id IS NULL THEN
        INSERT INTO accounts (name, code, account_type, slug, is_active, is_system)
        VALUES ('Owner''s Capital', '3001', 'equity', 'owner-capital', true, true)
        RETURNING id INTO v_capital_account_id;
    END IF;

    -- 2. Get Cash Account (To Debit - Assuming Cash introduced)
    SELECT id INTO v_cash_account_id FROM accounts WHERE slug = 'cash' OR name ILIKE '%Cash on Hand%';

    -- 3. Create Voucher
    v_voucher_no := 'OP-CAP-' || to_char(now(), 'MMDDSS');

    -- 4. Post Ledger Entries (Double Entry)
    -- CREDIT: Capital Account (Liability/Equity Increases on Credit)
    INSERT INTO ledger_entries (voucher_no, voucher_type, posting_date, account_id, debit_amount, credit_amount, narration, created_by)
    VALUES (v_voucher_no, 'opening', v_date, v_capital_account_id, 0, v_amount, 'Initial Capital Investment', auth.uid());

    -- DEBIT: Cash Account (Asset Increases on Debit)
    -- Note: This increases your cash balance too!
    INSERT INTO ledger_entries (voucher_no, voucher_type, posting_date, account_id, debit_amount, credit_amount, narration, created_by)
    VALUES (v_voucher_no, 'opening', v_date, v_cash_account_id, v_amount, 0, 'Capital Introduced as Cash', auth.uid());

    RAISE NOTICE '✅ Successfully added Capital Entry: Rs %', v_amount;
END $$;
