# =============================================================================
# Barki Traders — Fuel Trust Ledger (local / deployed instance)
# =============================================================================
# 1. Supabase par NAYA project banao (purane live project ki keys mat use karo)
# 2. Is file ko copy karo:  copy .env.example .env
# 3. Neeche ki values Supabase Dashboard → Project Settings → API se paste karo
# 4. Dev server restart: npm run dev
# =============================================================================

# Required — Supabase API (Project URL + anon public key)
VITE_SUPABASE_URL=https://YOUR-BARKI-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-barki-anon-key-here

# Recommended — browser mein auth alag rakhe (purane client se mix na ho)
VITE_CLIENT_SLUG=barki-traders

# Optional — development | staging | production
VITE_APP_ENV=development
