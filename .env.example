# =============================================================================
# Barki Traders - Fuel Trust Ledger
# =============================================================================
# Local development:
#   1. Copy this file: copy .env.example .env
#   2. Paste values from Supabase Dashboard -> Project Settings -> API
#   3. Restart the dev server
#
# Production on Vercel:
#   Add these same variables in Vercel Project Settings -> Environment Variables.
#   Do not rely on a local .env file for production deploys.
# =============================================================================

# Required - Supabase API project URL and anon public key
VITE_SUPABASE_URL=https://YOUR-BARKI-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-barki-anon-key-here

# Recommended - keeps browser auth storage separate from old client copies
VITE_CLIENT_SLUG=barki-traders

# Optional - development | staging | production
VITE_APP_ENV=development
